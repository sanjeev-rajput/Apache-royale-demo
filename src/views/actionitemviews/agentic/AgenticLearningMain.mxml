<j:VGroup xmlns:fx="http://ns.adobe.com/mxml/2009"
          xmlns:j="library://ns.apache.org/royale/jewel"
          xmlns:sp="library://ns.unhurdle.com/spectrum"
          width="100%"
          height="100%"
          itemsHorizontalAlign="itemsCenter"
          itemsVerticalAlign="itemsCenter"
          gap="1"
          initComplete="initializeAgent()">

    <fx:Script>
        <![CDATA[
            import org.apache.royale.events.Event;
            import org.apache.royale.html.HTMLText;
            import com.util.StringUtil;
            import com.model.Config;
            import com.model.ServiceLoader;
            import com.unhurdle.spectrum.BarLoader;
            import views.actionitemviews.learning.AiResponse;
            import org.apache.royale.utils.Timer;
            import org.apache.royale.jewel.VGroup;

            // Agentic Learning owns its own conversation state.
            private var conversationHistory:Array = [];
            private var requestInProgress:Boolean = false;
            private var serviceLoader:ServiceLoader;
            private var thinkingLabel:BarLoader;
            private var statusTimer:Timer;
            private var statusLoader:ServiceLoader;
            private var resourceLoaders:Array = [];
            private var currentRequestId:String;
            private var statusRequestInProgress:Boolean = false;
            private var requestCounter:int = 0;
            private var lastLearnerMessage:String;

            private var latestAssessmentContext:Object;
            private var activePracticePanel:Object;
            private var activePracticeParent:Object;
            private var resourceSequence:int = 0;

            private function initializeAgent():void
            {
                trace("Agentic Learning initialized.");
                document.body.classList.add("chatbot-page");
                addAgentMessage(
                    "Agent",
                    "Welcome to Agentic Learning. What would you like to learn today?"
                );
            }

            private function sendMessage():void
            {
                if (requestInProgress)
                    return;

                var message:String = questionInput.text;

                if (message == null ||
                    message.replace(/^\s+|\s+$/g, "") == "")
                {
                    return;
                }

                questionInput.text = "";
                lastLearnerMessage = message;
                addAgentMessage("You", message);

                conversationHistory.push({
                    role: "user",
                    content: message
                });

                requestInProgress = true;
                askButton.disabled = true;
                questionInput.disabled = true;
                showThinkingIndicator();

                currentRequestId = String(new Date().time) + "-" + String(++requestCounter);

                var requestData:Object = {
                    message: message,
                    history: conversationHistory,
                    requestId: currentRequestId
                };

                serviceLoader = new ServiceLoader();
                serviceLoader.reqMethod = "POST";
                serviceLoader.contentType = "application/json";
                serviceLoader.reqData = JSON.stringify(requestData);

                var apiUrl:String = Config.apiBaseUrl + "agent";

                serviceLoader.loadJData(
                    apiUrl,
                    handleAgentResponse,
                    ServiceLoader.DATA_TYPE_JSON,
                    handleAgentError,
                    false
                );

                startStatusPolling();
            }

            private function startStatusPolling():void
            {
                stopStatusPolling();
                statusTimer = new Timer(1200);
                statusTimer.addEventListener(Timer.TIMER, pollAgentStatus);
                statusTimer.start();
            }

            private function pollAgentStatus(event:Timer):void
            {
                if (!requestInProgress || statusRequestInProgress || currentRequestId == null)
                    return;

                statusRequestInProgress = true;
                statusLoader = new ServiceLoader();
                statusLoader.reqMethod = "GET";
                statusLoader.loadJData(
                    Config.apiBaseUrl + "agent/status/" + currentRequestId,
                    handleAgentStatus,
                    ServiceLoader.DATA_TYPE_JSON,
                    handleAgentStatusError,
                    false
                );
            }

            private function handleAgentStatus(response:Object):void
            {
                statusRequestInProgress = false;
                if (response == null || !requestInProgress || thinkingLabel == null)
                    return;

                if (response.message != null)
                    thinkingLabel.label = String(response.message);
            }

            private function handleAgentStatusError(event:Event):void
            {
                statusRequestInProgress = false;
                // Status polling is advisory; the main Agent request remains authoritative.
            }

            private function stopStatusPolling():void
            {
                if (statusTimer != null)
                {
                    statusTimer.stop();
                    statusTimer.removeEventListener(Timer.TIMER, pollAgentStatus);
                    statusTimer = null;
                }
                statusRequestInProgress = false;
                statusLoader = null;
            }

            private function handleAgentResponse(response:Object):void
            {
                finishRequest();

                if (response == null || response.success != true)
                {
                    var failureMessage:String = response != null && response.message != null
                        ? String(response.message)
                        : "The learning explanation could not be generated. Please try again.";
                    addAgentMessage("Agent", failureMessage);
                    trace("Agentic Learning explanation failed. code=" +
                        (response != null ? response.errorCode : "NO_RESPONSE"));
                    loadLearningResources(lastLearnerMessage);
                    return;
                }

                var reply:String = response.reply == null
                    ? "I couldn't generate a response."
                    : String(response.reply);

                // Display the LLM's returned text as-is. Resource cards are
                // fetched and rendered by a separate deterministic API call.
                if (response.llmAvailable !== false)
                {
                    conversationHistory.push({ role: "assistant", content: reply });
                }
                addAgentMessage("Agent", reply, response.showAiWarning === true);
                loadLearningResources(lastLearnerMessage);
            }

            private function loadLearningResources(message:String):void
            {
                if (message == null || message.replace(/^\s+|\s+$/g, "") == "")
                    return;

                var sequence:int = ++resourceSequence;
                var resourceContainer:VGroup = new VGroup();
                resourceContainer.percentWidth = 100;
                resourceContainer.gap = 1;
                resultsContainer.addElement(resourceContainer);

                var loader:ServiceLoader = new ServiceLoader();
                resourceLoaders.push(loader);
                loader.reqMethod = "POST";
                loader.contentType = "application/json";
                loader.reqData = JSON.stringify({ message: message });
                loader.loadJData(
                    Config.apiBaseUrl + "agent/resources",
                    function(response:Object):void
                    {
                        releaseResourceLoader(loader);
                        handleLearningResources(response, resourceContainer, sequence, message);
                    },
                    ServiceLoader.DATA_TYPE_JSON,
                    function(event:Event):void
                    {
                        releaseResourceLoader(loader);
                        handleLearningResourcesError(resourceContainer, message, sequence);
                    },
                    false
                );
            }

            private function releaseResourceLoader(loader:ServiceLoader):void
            {
                var index:int = resourceLoaders.indexOf(loader);
                if (index >= 0)
                    resourceLoaders.splice(index, 1);
            }

            private function handleLearningResources(
                response:Object,
                target:VGroup,
                sequence:int,
                message:String
            ):void
            {
                if (response == null || response.success != true)
                {
                    handleLearningResourcesError(target, message, sequence);
                    return;
                }

                if (response.results != null)
                {
                    for each (var item:Object in response.results)
                        addActivity(item, target);
                }

                if (sequence == resourceSequence)
                    latestAssessmentContext = response.assessmentContext;

                var catalogueAvailable:Boolean = response.availability != null &&
                    response.availability.catalogue === true;
                // Start YouTube only after the CSV results have been appended.
                // It is a separate request and cannot delay activity-card display.
                loadLearningVideos(message, target, sequence, catalogueAvailable);
            }

            private function handleLearningResourcesError(
                target:VGroup,
                message:String,
                sequence:int
            ):void
            {
                if (sequence == resourceSequence)
                    latestAssessmentContext = null;
                loadLearningVideos(message, target, sequence, false);
            }

            private function loadLearningVideos(
                message:String,
                target:VGroup,
                sequence:int,
                catalogueAvailable:Boolean
            ):void
            {
                var loader:ServiceLoader = new ServiceLoader();
                resourceLoaders.push(loader);
                loader.reqMethod = "POST";
                loader.contentType = "application/json";
                loader.reqData = JSON.stringify({ message: message });
                loader.loadJData(
                    Config.apiBaseUrl + "agent/videos",
                    function(response:Object):void
                    {
                        releaseResourceLoader(loader);
                        handleLearningVideos(response, target, sequence, catalogueAvailable);
                    },
                    ServiceLoader.DATA_TYPE_JSON,
                    function(event:Event):void
                    {
                        releaseResourceLoader(loader);
                        handleLearningVideosError(target, sequence, catalogueAvailable);
                    },
                    false
                );
            }

            private function handleLearningVideos(
                response:Object,
                target:VGroup,
                sequence:int,
                catalogueAvailable:Boolean
            ):void
            {
                var youtubeAvailable:Boolean = response != null && response.success == true &&
                    response.availability != null && response.availability.youtube === true;
                if (response != null && response.success == true && response.videos != null)
                {
                    for each (var video:Object in response.videos)
                        addYouTubeVideo(video, target);
                }

                if (target.numElements == 0 && !catalogueAvailable && !youtubeAvailable)
                {
                    var unavailable:HTMLText = new HTMLText();
                    unavailable.percentWidth = 100;
                    unavailable.html = "I couldn't retrieve learning activities or videos right now. Please try again later.";
                    target.addElement(unavailable);
                }

                if (sequence == resourceSequence && latestAssessmentContext != null)
                    showPracticeInvitation(target);
            }

            private function handleLearningVideosError(
                target:VGroup,
                sequence:int,
                catalogueAvailable:Boolean
            ):void
            {
                if (target.numElements == 0 && !catalogueAvailable)
                {
                    var unavailable:HTMLText = new HTMLText();
                    unavailable.percentWidth = 100;
                    unavailable.html = "Learning resources are temporarily unavailable. Please try again later.";
                    target.addElement(unavailable);
                }
                if (sequence == resourceSequence && latestAssessmentContext != null)
                    showPracticeInvitation(target);
            }

            private function removeActivePracticePanel():void
            {
                if (activePracticePanel == null)
                    return;

                if (activePracticePanel is AiAssessmentPanel)
                {
                    var aiPanel:AiAssessmentPanel = activePracticePanel as AiAssessmentPanel;
                    aiPanel.removeEventListener("assessmentDeclined", handleAssessmentDeclined);
                    aiPanel.removeEventListener("questionBankSelected", handleQuestionBankSelected);
                    if (activePracticeParent is VGroup)
                        VGroup(activePracticeParent).removeElement(aiPanel);
                    else
                        resultsContainer.removeElement(aiPanel);
                }
                else if (activePracticePanel is QbAssessmentPanel)
                {
                    var qbPanel:QbAssessmentPanel = activePracticePanel as QbAssessmentPanel;
                    qbPanel.removeEventListener("qbPracticeCompleted", handleQbPracticeCompleted);
                    if (activePracticeParent is VGroup)
                        VGroup(activePracticeParent).removeElement(qbPanel);
                    else
                        resultsContainer.removeElement(qbPanel);
                }

                activePracticePanel = null;
                activePracticeParent = null;
            }

            private function showPracticeInvitation(target:VGroup = null):void
            {
                removeActivePracticePanel();
                if (latestAssessmentContext == null)
                    return;

                var panel:AiAssessmentPanel = new AiAssessmentPanel();
                panel.assessmentContext = latestAssessmentContext;
                panel.addEventListener("assessmentDeclined", handleAssessmentDeclined);
                panel.addEventListener("questionBankSelected", handleQuestionBankSelected);
                activePracticePanel = panel;
                activePracticeParent = target;
                if (target != null)
                    target.addElement(panel);
                else
                    resultsContainer.addElement(panel);
            }

            private function handleAssessmentDeclined(event:Event):void
            {
                removeActivePracticePanel();
            }

            private function handleQuestionBankSelected(event:Event):void
            {
                var target:VGroup = activePracticeParent as VGroup;
                removeActivePracticePanel();
                var panel:QbAssessmentPanel = new QbAssessmentPanel();
                panel.addEventListener("qbPracticeCompleted", handleQbPracticeCompleted);
                activePracticePanel = panel;
                activePracticeParent = target;
                if (target != null)
                    target.addElement(panel);
                else
                    resultsContainer.addElement(panel);
            }

            private function handleQbPracticeCompleted(event:Event):void
            {
                var target:VGroup = activePracticeParent as VGroup;
                showPracticeInvitation(target);
            }

            // Match AI Learning's existing clickable activity-card implementation.
            private function addActivity(item:Object, target:VGroup = null):void
            {
                if (item == null)
                    return;

                var detailsUi:AiResponse = new AiResponse();
                detailsUi.aiResponse = item;
                if (target != null)
                    target.addElement(detailsUi);
                else
                    resultsContainer.addElement(detailsUi);
            }

            // Render each optional YouTube result in its own independent card.
            private function addYouTubeVideo(video:Object, target:VGroup = null):void
            {
                if (video == null || video.videoId == null)
                    return;

                var videoCard:YouTubeVideoCard = new YouTubeVideoCard();
                videoCard.video = video;
                if (target != null)
                    target.addElement(videoCard);
                else
                    resultsContainer.addElement(videoCard);
            }

            private function handleAgentError(event:Event):void
            {
                finishRequest();

                addAgentMessage(
                    "Agent",
                    "I’m unable to generate your learning explanation right now. Please try again shortly."
                );
                loadLearningResources(lastLearnerMessage);
                trace("Agentic Learning explanation API transport request failed; resource retrieval was started independently.");
            }

            private function finishRequest():void
            {
                requestInProgress = false;
                stopStatusPolling();
                hideThinkingIndicator();
                askButton.disabled = false;
                questionInput.disabled = false;
            }

            private function showThinkingIndicator():void
            {
                hideThinkingIndicator();

                thinkingLabel = new BarLoader();
                thinkingLabel.label = "Thinking...";
                thinkingLabel.showPercentage = "false";
                thinkingLabel.small = "true";
                thinkingLabel.indeterminate = "true";

                resultsContainer.addElement(thinkingLabel);
            }

            private function hideThinkingIndicator():void
            {
                if (thinkingLabel != null)
                {
                    resultsContainer.removeElement(thinkingLabel);
                    thinkingLabel = null;
                }
            }

            private function addAgentMessage(
                speaker:String,
                message:String,
                showAiWarning:Boolean = false
            ):void
            {
                var label:HTMLText = new HTMLText();
                label.percentWidth = 100;

                var labelColor:String =
                    speaker == "You" ? "#DCEEFF" : "#E2F3E5";

                label.html =
                    "<span style='background-color:" + labelColor +
                    "; color:#222222; padding:3px 8px; border-radius:4px;'>" +
                    "<b>" + StringUtil.escapeHTML(speaker) + ":</b>" +
                    "</span> " +
                    renderMessageHtml(message, showAiWarning);

                resultsContainer.addElement(label);
            }

            // Match the compact AI-generated warning used by AI K-12 Learning.
            // Catalogue-only replies do not display this notice.
            private function renderMessageHtml(
                message:String,
                showAiWarning:Boolean
            ):String
            {
                var mainHtml:String = StringUtil.markdownToHtml(message);

                if (!showAiWarning)
                    return mainHtml;

                var warningHtml:String =
                    "<p style=\"background-color:#FFF2B2;" +
                    "color:#B71C1C;" +
                    "font-size:0.85em;" +
                    "padding:8px 10px;" +
                    "margin-top:0px;" +
                    "border:1px solid #E5C84B;" +
                    "border-radius:4px;\">" +
                    "<b>⚠️ AI-generated content notice:</b> " +
                    "This response was generated by AI and may contain inaccuracies. " +
                    "Please check important learning information with your teacher." +
                    "</p>";

                return mainHtml + warningHtml;
            }

            private function createNewConversation():void
            {
                if (requestInProgress)
                    return;

                conversationHistory = [];
                clearVisibleConversation();

                addAgentMessage(
                    "Agent",
                    "A new learning session has started. What would you like to learn?"
                );
            }

            private function clearCurrentConversation():void
            {
                if (requestInProgress)
                    return;

                conversationHistory = [];
                clearVisibleConversation();

                addAgentMessage(
                    "Agent",
                    "Conversation cleared. Ask me anything when you're ready."
                );
            }

            private function clearVisibleConversation():void
            {
                hideThinkingIndicator();

                while (resultsContainer.numElements > 0)
                {
                    resultsContainer.removeElement(
                        resultsContainer.getElementAt(0)
                    );
                }
            }

            public function disposeMe():void
            {
                stopStatusPolling();
                document.body.classList.remove("chatbot-page");
                trace("Agentic Learning disposed.");
            }
        ]]>
    </fx:Script>

    <j:HGroup width="100%"
              className="conversation-toolbar"
              itemsVerticalAlign="itemsCenter">
        <sp:Button text="New"
                   click="createNewConversation()"
                   className="new-conversation-btn"/>
        <sp:Button text="Clear"
                   click="clearCurrentConversation()"
                   className="clear-conversation-btn"/>
        <j:Spacer/>
        <j:Label text="AI Learning Agent"
                 className="language-label"/>
    </j:HGroup>

    <j:VGroup id="resultsContainer" className="Agentic-resultsContainer"
              width="100%"
              height="100%"
              gap="1">
        <j:Label width="100%"
                 text="Your intelligent, goal-driven learning companion."/>
        <j:beads>
            <j:ScrollingViewport/>
        </j:beads>
    </j:VGroup>

    <j:HGroup width="80%"
              itemsVerticalAlign="itemsCenter"
              className="AiPromptContainer">
        <sp:TextField id="questionInput"
                      width="100%"
                      placeholder="What would you like to learn?"
                      onEnter="sendMessage()"/>
        <sp:Button id="askButton"
                   text="Ask"
                   click="sendMessage()"/>
    </j:HGroup>
</j:VGroup>
