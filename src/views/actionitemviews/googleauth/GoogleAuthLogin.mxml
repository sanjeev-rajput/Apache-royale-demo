<j:VGroup xmlns:fx="http://ns.adobe.com/mxml/2009"
        xmlns:sp="library://ns.unhurdle.com/spectrum"
        xmlns:j="library://ns.apache.org/royale/jewel"          
        itemsHorizontalAlign="itemsCenter" height="100%" width="100%" initComplete="initLogin()">
        <fx:Script>
            <![CDATA[
                import views.actionitemviews.googleauth.GoogleAuthController;

                private var googleAuthController:GoogleAuthController
                private function initLogin():void{
                    googleAuthController = GoogleAuthController.getInstance();
                    
                }

                private function login():void {
                    if(googleAuthController.checkExistingLogin()){
                        console.log("User already logged in", googleAuthController.getLoginDetails());
                    } else {
                        googleAuthController.login();
                    }
                }
                
            ]]>
        </fx:Script>

    <j:Button text="Login with Google" id="loginBtn" width="200" height="40" click="login()"/>
</j:VGroup>