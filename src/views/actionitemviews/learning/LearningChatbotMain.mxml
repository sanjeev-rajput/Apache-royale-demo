<j:VGroup xmlns:fx="http://ns.adobe.com/mxml/2009"
         xmlns:j="library://ns.apache.org/royale/jewel"
         xmlns:sp="library://ns.unhurdle.com/spectrum"
         xmlns:html="library://ns.apache.org/royale/html"
         xmlns="library://ns.apache.org/royale/html" xmlns:learning="views.actionitemviews.learning.*"
         width="100%"
         height="100%"
         itemsHorizontalAlign="itemsCenter" itemsVerticalAlign="itemsCenter" gap="1"
         initComplete="initializeChat()" >

    <fx:Script>
        <![CDATA[
            import org.apache.royale.events.Event;
            import com.model.ServiceLoader;
            import com.model.Config;
            import views.ContentLoaderIframe;
            import org.apache.royale.html.HTMLText;
            import com.unhurdle.spectrum.Button;
            import views.actionitemviews.learning.AiResponse;
            import com.util.StringUtil;
            import views.actionitemviews.learning.ImportExportChat;
            import org.apache.royale.utils.callLater;
            import com.event.DsEvent;
            import com.unhurdle.spectrum.BarLoader;
            


            private var httpService:ServiceLoader;
            private var thinkingLabel:BarLoader;
            private var sUrl:String = Config.apiBaseUrl;

            // One conversation ID is reused for the lifetime of this chatbot.
            // Node owns the actual conversation state.
            private var conversationId:String = "";

            // Ordered transcript: chat messages and learning-module cards.
            private var transcriptEntries:Array = [];
            private var transcriptElements:Array = [];
            private var importExportHelper:ImportExportChat = new ImportExportChat();

            // --------------------------------------------------
            // Entry point
            // --------------------------------------------------

            private function sendMessage():void
            {
                var message:String = questionInput.text;

                if (!message ||
                    message.replace(/^\s+|\s+$/g, "") == "")
                {
                    return;
                }

                questionInput.text = "";
                addChatMessage("You", message);

                sendToChat(message);
            }

            // --------------------------------------------------
            // Node chat API
            // --------------------------------------------------

            private function sendToChat(message:String):void
            {
                questionInput.disabled = true;
                askButton.disabled = true;
                showThinkingIndicator();
                try{
                    httpService = new ServiceLoader();
                    httpService.reqMethod = "POST";
                    httpService.contentType = "application/json";

                    // ServiceLoader.loadJData() accepts five parameters.
                    // POST data is supplied through reqData.
                    var requestData:Object = {
                        conversationId: conversationId,
                        message: message
                    };
                    httpService.reqData = JSON.stringify(requestData);
                    var requestUrl:String = sUrl + "chat";
                    httpService.loadJData(
                        requestUrl,
                        chatDataLoadEventHandler,
                        ServiceLoader.DATA_TYPE_JSON,
                        errorEventHandler,
                        false
                    );
                }catch(err:Error){
                    trace("sendToChat ERROR: " + err.message);
                    addChatMessage(
                        "Tutor",
                        "Unable to send your question. Please try again."
                    );
                    finishRequest();
                }

                
            }

            private function chatDataLoadEventHandler(d:Object):void
            {
                if (d == null)
                {
                    addChatMessage(
                        "Tutor",
                        "I didn't receive a response from the learning service."
                    );

                    finishRequest();
                    return;
                }

                // Node creates/returns the conversation ID.
                if (d.conversationId != null &&
                    String(d.conversationId) != "")
                {
                    conversationId = String(d.conversationId);
                }

                // The conversation interpreter is now responsible for
                // generating the tutor response.
                if (d.reply != null &&
                    String(d.reply) != "")
                {
                    addChatMessage(
                        "Tutor",
                        String(d.reply)
                    );
                }

                // Node also owns result filtering and pagination.
                // Royale only renders the returned activities.
                if (d.results != null)
                {
                    for each (var item:Object in d.results)
                    {
                        addActivity(item);
                    }
                }

                finishRequest();
            }

            // --------------------------------------------------
            // Chat messages
            // --------------------------------------------------

            private function addChatMessage(speaker:String, message:String):void
            {
                transcriptEntries.push({
                    type: "message",
                    speaker: speaker,
                    message: message
                });
                renderChatMessage(speaker, message);
            }

            // Return true when the reader is already close to the bottom.
            // This lets the chat follow new content without interrupting someone
            // who has scrolled up to read an earlier message.
            private function isNearBottom():Boolean
            {
                if (resultsContainer == null || resultsContainer.element == null)
                    return true;

                var viewport:Object = resultsContainer.element;

                var remaining:Number =
                    Number(viewport.scrollHeight) -
                    Number(viewport.scrollTop) -
                    Number(viewport.clientHeight);

                return remaining <= 80;
            }

            // Run after the component has updated its layout.
            private function scrollToBottom():void
            {
                if (resultsContainer == null || resultsContainer.element == null)
                    return;

                var viewport:Object = resultsContainer.element;
                viewport.scrollTop = viewport.scrollHeight;
            }

            private function renderChatMessage(speaker:String, message:String):void
            {
                // Always follow a newly sent user message. For tutor messages,
                // follow only when the reader was already near the bottom.
                var shouldScroll:Boolean =
                    (speaker == "You") || isNearBottom();

                var label:HTMLText = new HTMLText();
                label.percentWidth = 100;

                var messageHtml:String = renderMessageHtml(message);
                var labelColor:String = speaker == "You" ? "#DCEEFF" : "#E2F3E5";

                label.html =
                    "<span style='background-color:" + labelColor +
                    "; color:#222222; padding:3px 8px; border-radius:4px;'>" +
                    "<b>" + StringUtil.escapeHTML(speaker) + ":</b>" +
                    "</span> " +
                messageHtml;

                resultsContainer.addElement(label);
                transcriptElements.push(label);

                if (shouldScroll)
                    callLater(scrollToBottom);
            }

            // Render the AI-fallback consent notice as a compact warning panel.
            // All other tutor messages continue through the existing Markdown renderer.
            
            private function renderMessageHtml(message:String):String
            {
                var markers:Array = [
                    "⚠️ **Please note:**",
                    "⚠️ **AI-generated content notice:**"
                ];

                var warningStart:int = -1;
                var warningMarker:String = "";

                for each (var marker:String in markers)
                {
                    var index:int = message.indexOf(marker);
                    if (index >= 0 && (warningStart < 0 || index < warningStart))
                    {
                        warningStart = index;
                        warningMarker = marker;
                    }
                }

                if (warningStart < 0)
                    return StringUtil.markdownToHtml(message);

                var mainText:String = message.substring(0, warningStart);
                var warningText:String =
                    message.substring(warningStart + warningMarker.length);

                var warningTitle:String = warningMarker.indexOf("Please note") >= 0
                    ? "⚠️ Please note:"
                    : "⚠️ AI-generated content notice:";

                var warningHtml:String =
                    "<p style=\"background-color:#FFF2B2;" +
                    "color:#B71C1C;" +
                    "font-size:0.85em;" +
                    "padding:8px 10px;" +
                    "margin-top:0px;" +
                    "border:1px solid #E5C84B;" +
                    "border-radius:4px;\">" +
                    "<b>" + warningTitle + "</b>" +
                    StringUtil.markdownToHtml(warningText) +
                    "</p>";

                return StringUtil.markdownToHtml(mainText) + warningHtml;
            }


            private function restoreTranscript(entries:Array):void
            {
                trace("Restoring transcript with " + String(entries.length) + " entries.");
                // Remove only transcript elements. Keep the title and prompt labels.
                for (var i:int = transcriptElements.length - 1; i >= 0; i--)
                {
                    resultsContainer.removeElement(transcriptElements[i]);
                }
                transcriptElements = [];
                transcriptEntries = [];

                for each (var entry:Object in entries)
                {
                    if (entry == null)
                        continue;

                    var entryType:String = entry.type == null ? "message" : String(entry.type);
                    if (entryType == "module" && entry.item != null)
                    {
                        var savedItem:Object = entry.item;
                        transcriptEntries.push({ type: "module", item: savedItem });
                        renderActivity(savedItem);
                    }
                    else if (entry.speaker != null && entry.message != null)
                    {
                        var speaker:String = String(entry.speaker);
                        var message:String = String(entry.message);
                        transcriptEntries.push({
                            type: "message",
                            speaker: speaker,
                            message: message
                        });
                        renderChatMessage(speaker, message);
                    }
                }

                // A restored transcript is visual history, not a restored server session.
                conversationId = "chat-" + String(new Date().time) + "-" +
                    String(int(Math.random() * 1000000));
            }

            // --------------------------------------------------
            // Activity cards
            // --------------------------------------------------

            private function addActivity(item:Object):void
            {
                if (item == null)
                    return;

                // Save the complete activity payload so its card can be rebuilt on import.
                transcriptEntries.push({ type: "module", item: item });
                renderActivity(item);
            }

            private function renderActivity(item:Object):void
            {
                if (item == null)
                    return;

                var shouldScroll:Boolean = isNearBottom();

                var detailsUi:AiResponse = new AiResponse();
                detailsUi.aiResponse = item;
                resultsContainer.addElement(detailsUi);
                transcriptElements.push(detailsUi);

                if (shouldScroll)callLater(scrollToBottom);
            }

            private function loadModule(item:Object):void
            {
                if (item == null ||
                    item.location == null ||
                    String(item.location) == "")
                {
                    addChatMessage(
                        "Tutor",
                        "This activity does not have a module location."
                    );
                    return;
                }

                ContentLoaderIframe.instance.loadPage(
                    String(item.location)
                );
            }

            private function showThinkingIndicator():void
            {
                hideThinkingIndicator();

                var shouldScroll:Boolean = isNearBottom();

                thinkingLabel = new BarLoader();
                thinkingLabel.label="Thinking...";
                thinkingLabel.showPercentage="false" 
                thinkingLabel.small="true" 
                thinkingLabel.indeterminate="true"
                resultsContainer.addElement(thinkingLabel);

                if (shouldScroll)callLater(scrollToBottom);
            }

            private function hideThinkingIndicator():void
            {
                if (thinkingLabel != null)
                {
                    //if (resultsContainer.contains(thinkingLabel))
                    resultsContainer.removeElement(thinkingLabel);
                    thinkingLabel = null;
                }
            }

            private function finishRequest():void
            {
                hideThinkingIndicator();
                questionInput.disabled = false;
                askButton.disabled = false;
                questionInput.focus();
            }

            private function errorEventHandler(
                event:Event
            ):void
            {
                addChatMessage(
                    "Tutor",
                    "Unable to connect to the learning service. " +
                    "Please try again."
                );

                trace(event.toString());
                finishRequest();
            }

            private function onKeyDown():void
            {
                sendMessage();
            }

            // --------------------------------------------------
            // Initialization
            // --------------------------------------------------

            private function initializeChat():void
            {
                document.body.classList.add("chatbot-page");
                // Keep one stable ID for this browser-side chat session.
                conversationId =
                    "chat-" +
                    String(new Date().time) +
                    "-" +
                    String(int(Math.random() * 1000000));

                trace(
                    "Learning chatbot conversationId: " +
                    conversationId
                );
            }

            private function multiLingualSelection(event:Event):void {
                var menu:ActionMenu = event.currentTarget as ActionMenu;
                if (menu == null)
                    return;
                var selected:String = String(menu.selectedItem.label);
                if (selected == "Multilingual Tutor") {
                    DsEvent.instance.dispatch(DsEvent.OPEN_MULTILINGUAL_TUTOR_EVENT);
                }
                menu.selectedIndex = -1;
            }

            public function conversationActions():void {
                trace("conversationActions");
            }
            public function disposeMe():void {
                document.body.classList.remove("chatbot-page");
            }
        ]]>
    </fx:Script>

    <j:HGroup width="100%" className="conversation-toolbar" itemsVerticalAlign="itemsCenter">
        <sp:Button text="Import" click="importExportHelper.importJsonFile(restoreTranscript)" className="new-conversation-btn"/>
        <sp:Button text="Export" click="importExportHelper.exportChatJson(conversationId,transcriptEntries);" className="new-conversation-btn"/>
        <sp:Button text="Clear" click="restoreTranscript([])" className="clear-conversation-btn"/>
        <j:Spacer/>
        <j:Label id="selectedLang" className="language-label"/>
    </j:HGroup>
    <j:VGroup id="resultsContainer" height="100%" width="100%" gap="1">
        <j:Label text="Learning Chatbot"/>
        <j:Label text="What would you like to learn today?"/>
        <j:beads>
            <j:ScrollingViewport/>
        </j:beads>
    </j:VGroup>
    <j:HGroup id="qryCtr" width="80%" itemsVerticalAlign="itemsCenter" className="AiPromptContainer">
        <sp:TextField id="questionInput" placeholder="e.g. I want to learn about Alphabet" width="100%"
        onEnter="onKeyDown()"/>
        <sp:Button id="askButton" className="chatbot-text-button" text="ask"
            click="sendMessage()"/>
        <sp:ActionMenu quiet="true" dataProvider="[Multilingual Tutor]" change="multiLingualSelection(event)"/>
        
    </j:HGroup>

    <fx:Declarations>
        <!--
            Initialize the conversation ID when the component is created.
        -->
    </fx:Declarations>

</j:VGroup>
