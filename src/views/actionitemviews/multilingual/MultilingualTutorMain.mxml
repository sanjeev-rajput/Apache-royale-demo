<j:VGroup xmlns:fx="http://ns.adobe.com/mxml/2009"
          xmlns:j="library://ns.apache.org/royale/jewel"
          xmlns:sp="library://ns.unhurdle.com/spectrum"
          xmlns:html="library://ns.apache.org/royale/html"
          width="100%"
          height="100%"
          itemsHorizontalAlign="itemsCenter"
          itemsVerticalAlign="itemsCenter"
          gap="1"
          initComplete="initializeTutor()">
    <fx:Script>
        <![CDATA[
            import com.event.DsEvent;
            import org.apache.royale.events.Event;
            import org.apache.royale.html.HTMLText;
            import com.util.StringUtil;
            import com.model.Config;
            import com.model.ServiceLoader;
            import com.unhurdle.spectrum.BarLoader;

            private var selectedLanguage:String = "Hinglish";
            private var disposed:Boolean = false;
            private var conversationId:String = null;
            private var requestInProgress:Boolean = false;
            private var serviceLoader:ServiceLoader;
            private var thinkingLabel:BarLoader;

            private function initializeTutor():void {
                trace("Multilingual Tutor initialized.");
                addTutorMessage(
                    "Tutor",
                    "Namaste! Welcome to Multilingual Tutor. " +
                    "Aaj hum kya seekhna chahenge?"
                );
                languageMenu.selectedIndex = 0;
                languageMenu.dispatchEvent(new Event("change"));
            }
            private function createNewConversation():void {
                if (requestInProgress) return;

                serviceLoader = new ServiceLoader();
                serviceLoader.reqMethod = "POST";
                serviceLoader.contentType = "application/json";

                var apiUrl:String =
                    Config.apiBaseUrl + "multilingual/conversation";

                serviceLoader.loadJData(
                    apiUrl,
                    handleNewConversationResponse,
                    ServiceLoader.DATA_TYPE_JSON,
                    handleConversationError,
                    false
                );
            }

            private function handleNewConversationResponse(response:Object):void {
                if (response == null || response.success != true) {
                    addTutorMessage("Tutor", "Unable to create a new conversation.");
                    return;
                }

                conversationId = String(response.conversationId);
                hideThinkingIndicator();

                // Clear the visible chat and start fresh.
                while (resultsContainer.numElements > 0) resultsContainer.removeElement(resultsContainer.getElementAt(0));
                addTutorMessage(
                    "Tutor",
                    "Namaste! A new conversation has started. What would you like to learn?"
                );
            }

            private function handleConversationError(event:Event):void {
                addTutorMessage(
                    "Tutor",
                    "Unable to manage the conversation. Please try again."
                );
            }

            private function handleLanguageChange(event:Event):void {
                var menu:ActionMenu = event.currentTarget as ActionMenu;
                if (menu == null || menu.selectedItem == null) return;
                var selected:String = String(menu.selectedItem.label);
                selectedLang.text = "Language: " + selected;
                if (selected == "Go back") {
                    menu.selectedIndex = -1;
                    DsEvent.instance.dispatch(DsEvent.CLOSE_MULTILINGUAL_TUTOR_EVENT);
                    return;
                }
                selectedLanguage = selected;
                trace("Selected language: " + selectedLanguage);
            }

            private function sendMessage():void {
                if (requestInProgress)return;
                var message:String = questionInput.text;
                if (message == null ||
                    message.replace(/^\s+|\s+$/g, "") == "") {
                    return;
                }

                questionInput.text = "";

                // Display the user's message immediately.
                addTutorMessage("You", message);
                requestInProgress = true;
                showThinkingIndicator();
                // Prepare API request.
                var requestData:Object = {
                    message: message,
                    language: selectedLanguage
                };
                // Reuse conversation ID after the first response.
                if (conversationId != null) {
                    requestData.conversationId = conversationId;
                }
                // Create ServiceLoader.
                serviceLoader = new ServiceLoader();
                serviceLoader.reqMethod = "POST";
                serviceLoader.contentType = "application/json";
                serviceLoader.reqData = JSON.stringify(requestData);
                var apiUrl:String = Config.apiBaseUrl + "multilingual/chat";
                serviceLoader.loadJData(
                    apiUrl,
                    handleTutorResponse,
                    ServiceLoader.DATA_TYPE_JSON,
                    handleTutorError,
                    false
                );
            }

            private function handleTutorResponse(response:Object):void {
                requestInProgress = false;
                hideThinkingIndicator();
                if (response == null || response.success != true) {
                    addTutorMessage("Tutor", "Unable to generate a response.");
                    return;
                }
                // Save conversation ID returned by backend.
                if (response.conversationId != null) {
                    conversationId = String(response.conversationId);
                }
                // Display AI response.
                if (response.reply != null) {
                    addTutorMessage("Tutor", String(response.reply));
                }
            }

            private function handleTutorError(event:Event):void {
                requestInProgress = false;
                hideThinkingIndicator();
                addTutorMessage(
                    "Tutor",
                    "Sorry, something went wrong. Please try again."
                );
                trace("Multilingual Tutor API request failed.");
            }

            private function showThinkingIndicator():void {
                hideThinkingIndicator();

                thinkingLabel = new BarLoader();
                thinkingLabel.label = "Thinking...";
                thinkingLabel.showPercentage = "false";
                thinkingLabel.small = "true";
                thinkingLabel.indeterminate = "true";

                resultsContainer.addElement(thinkingLabel);
            }

            private function hideThinkingIndicator():void {
                if (thinkingLabel != null) {
                    resultsContainer.removeElement(thinkingLabel);
                    thinkingLabel = null;
                }
            }

            private function addTutorMessage(
                speaker:String,
                message:String
            ):void {
                var label:HTMLText = new HTMLText();
                label.percentWidth = 100;

                var labelColor:String =
                    speaker == "You" ? "#DCEEFF" : "#E2F3E5";

                label.html =
                    "<span style='background-color:" + labelColor +
                    "; color:#222222; padding:3px 8px; border-radius:4px;'>" +
                    "<b>" + StringUtil.escapeHTML(speaker) + ":</b>" +
                    "</span> " +
                    StringUtil.markdownToHtml(message);

                resultsContainer.addElement(label);
            }
            
            private function clearCurrentConversation():void {
                    if (requestInProgress) return;

                    if (conversationId == null || conversationId == "") {
                        return;
                    }

                    serviceLoader = new ServiceLoader();
                    serviceLoader.reqMethod = "DELETE";

                    var apiUrl:String =
                        Config.apiBaseUrl +
                        "multilingual/conversation/" +
                        conversationId;

                    serviceLoader.loadJData(
                        apiUrl,
                        handleClearConversationResponse,
                        ServiceLoader.DATA_TYPE_JSON,
                        handleConversationError,
                        false
                    );
                }

                private function handleClearConversationResponse(response:Object):void {
                    if (response == null || response.success != true) {
                        addTutorMessage("Tutor", "Unable to clear this conversation.");
                        return;
                    }
                    conversationId = null;
                    hideThinkingIndicator();
                    while (resultsContainer.numElements > 0) resultsContainer.removeElement(resultsContainer.getElementAt(0));
                    addTutorMessage(
                        "Tutor",
                        "Conversation cleared. Start a new conversation to continue learning."
                    );
                }

            public function disposeMe():void {
                disposed = true;
                trace("Multilingual Tutor disposed.");
            }
        ]]>
    </fx:Script>
    <j:HGroup width="100%" className="conversation-toolbar" itemsVerticalAlign="itemsCenter">
        <sp:Button text="New" click="createNewConversation()" className="new-conversation-btn"/>
        <sp:Button text="Clear" click="clearCurrentConversation()" className="clear-conversation-btn"/>
        <j:Spacer/>
        <j:Label id="selectedLang" className="language-label"/>
    </j:HGroup>
    <j:VGroup id="resultsContainer" width="100%" height="100%" gap="1">
        <j:Label text="Multilingual Tutor. Learn concepts in the language you are comfortable with." width="100%"/>
        <j:Label width="100%" text="Learn concepts in the language you are comfortable with."/>
        <j:beads>
            <j:ScrollingViewport/>
        </j:beads>
    </j:VGroup>
    <j:HGroup width="80%" itemsVerticalAlign="itemsCenter" className="AiPromptContainer">
        <sp:TextField id="questionInput" width="100%" placeholder="Ask anything..." onEnter="sendMessage()"/>
        <sp:Button text="ask" click="sendMessage()"/>
        <sp:ActionMenu id="languageMenu" quiet="true"
                       dataProvider="[Hinglish, Hindi, English, Go back]"
                       change="handleLanguageChange(event)"/>
        
    </j:HGroup>
</j:VGroup>
